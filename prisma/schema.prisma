generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ApplicationUsage {
  id              Int       @id @default(autoincrement())
  applicationName String
  usageCount      Int       @default(0)
  date            DateTime?
  createdAt       DateTime  @default(now())
}

model Computer {
  id            Int             @id @default(autoincrement())
  computerName  String          @unique
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  ComputerUsage ComputerUsage[]
  DailyTransfer DailyTransfer[]
  FileTransfer  FileTransfer[]
}

model ComputerUsage {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  computerId  Int
  date        DateTime
  activeHours Float    @default(0)
  createdAt   DateTime @default(now())
  Computer    Computer @relation(fields: [computerId], references: [id])
  Employee    Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, computerId, date])
}

model DailyTransfer {
  id         Int      @id @default(autoincrement())
  date       DateTime
  computerId Int
  count      Int      @default(0)
  createdAt  DateTime @default(now())
  Computer   Computer @relation(fields: [computerId], references: [id])

  @@unique([date, computerId])
}

model EmailLog {
  id         Int       @id @default(autoincrement())
  date       DateTime
  count      Int       @default(1)
  employeeId Int?
  createdAt  DateTime  @default(now())
  Employee   Employee? @relation(fields: [employeeId], references: [id])
}

model Employee {
  id               Int             @id @default(autoincrement())
  username         String          @unique
  displayName      String?
  totalActiveHours Float           @default(0)
  focusRatio       Float           @default(0)
  uniqueLoginDays  Int             @default(0)
  emailCount       Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime
  ComputerUsage    ComputerUsage[]
  EmailLog         EmailLog[]
}

model FileTransfer {
  id             Int      @id @default(autoincrement())
  computerId     Int
  transferMethod String   @default("リムーバブルドライブ")
  fileType       String
  count          Int      @default(1)
  date           DateTime
  createdAt      DateTime @default(now())
  Computer       Computer @relation(fields: [computerId], references: [id])
}

model WorkforceMetrics {
  id                  Int      @id @default(autoincrement())
  date                DateTime @unique
  avgDailyActiveHours Float
  overallFocusRatio   Float
  totalLogins         Int
  uniqueEmployees     Int
  uniqueComputers     Int
  totalComputerEvents Int
  activityTrendPct    Float
  createdAt           DateTime @default(now())
}
